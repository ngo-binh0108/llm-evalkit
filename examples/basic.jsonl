# One case per line. Lines starting with '#' are comments.
{"id": "capital-france", "prompt": "What is the capital of France? Answer in one word.", "checks": [{"type": "contains", "value": "Paris"}, {"type": "max_words", "value": 3}], "tags": ["facts"]}
{"id": "arithmetic", "prompt": "What is 17 * 23? Reply with only the number.", "checks": [{"type": "regex", "pattern": "^\\s*391\\s*$"}], "tags": ["math"]}
